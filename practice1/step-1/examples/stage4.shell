# ls: текущий каталог, заданный каталог, файл, пустой каталог, ошибки
ls
ls /home
ls /empty
ls /readme.txt
ls /missing
ls / /home
# cd: абсолютный путь, относительный, точка, родитель, корень, ошибки
cd /home/student/docs
ls
head -n 1 "my notes.txt"
cd .
cd ..
cd ./docs/../..
cd
cd /../../
cd /missing
cd /readme.txt
cd / /home
# head: по умолчанию, -n, ноль строк, неверные параметры и пути
head /readme.txt
head -n 2 /readme.txt
head -n 0 /readme.txt
head
head -n
head -n x /readme.txt
head -n -1 /readme.txt
head /missing
head /home
head /binary.bin
head /readme.txt /binary.bin
# tree: текущий каталог, каталог, файл, пустой каталог, ошибки
tree
tree /home
tree /readme.txt
tree /empty
tree /missing
tree / /home
# Общие ошибки и выход
unknown
ls "незакрытая кавычка
exit extra
exit
